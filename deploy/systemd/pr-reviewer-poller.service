# pr-reviewer-poller.service — poller GitHub advisory (mode réel, aucun webhook).
# HARDENING 2026-09-07 : tourne sous l'utilisateur prreview (sans docker, sans sudo
# nécessaire — purement API GitHub read-only). L'entrypoint self-load .env.
[Unit]
Description=pr-reviewer poller (GitHub advisory — same-repo, non-draft, auteur autorisé)
Documentation=https://github.com/Revens2/pr-reviewer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=prreview
Group=prreview
WorkingDirectory=/home/juliann/pr-reviewer/transport
EnvironmentFile=/home/juliann/pr-reviewer/transport/state/systemd.env
ExecStart=/usr/bin/python3 /home/juliann/pr-reviewer/transport/poller.py
Restart=on-failure
RestartSec=15
Nice=5
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pr-reviewer-poller

[Install]
WantedBy=multi-user.target
