# Variables attendues par le transport (déployé dans transport/state/.env, chmod 600).
# Copier vers transport/state/.env puis renseigner — ne jamais versionner le fichier réel.

# Token GitHub orchestrateur (PAT classique scope `repo`, ou GitHub App) :
# lecture repo/PR/compare + écriture commit statuses + commentaires issues.
# Ne quitte JAMAIS l'orchestrateur ; jamais transmis au conteneur Freebuff.
export GH_TRANSPORT_TOKEN=replace_me_with_a_real_pat_never_commit_the_value

# Secret HMAC du receiver webhook (optionnel — receiver non utilisé en mode poller).
export WEBHOOK_SECRET=replace_me_webhook_secret

# Optionnel — mode GitHub App (Check Runs natifs) au lieu du PAT :
# export GH_TRANSPORT_APP_ID=
# export GH_TRANSPORT_PRIVATE_KEY=/path/to/app.pem
# export GH_TRANSPORT_INSTALLATION_ID=
